# ---- Trading 212 ----
# practice = demo.trading212.com (fake money). live = real money. Default is practice.
T212_ENV=practice

# Generate in the T212 app: menu > Settings > API (Beta). Switch to Practice FIRST for a demo key.
# Newer keys come as a key + secret pair (Basic auth). Older keys are a single token.
T212_API_KEY=
T212_API_SECRET=

# ---- Anthropic (analyst agent) ----
ANTHROPIC_API_KEY=

# ---- Telegram bot (phone access) ----
# From @BotFather: /newbot, copy the token.
TELEGRAM_BOT_TOKEN=
# Your own chat id. Leave blank on first deploy: message the bot and it tells you the id.
TELEGRAM_CHAT_ID=
# Any long random string. Telegram sends it with every webhook call so nobody else can.
TELEGRAM_WEBHOOK_SECRET=

# ---- Vercel ----
# Any long random string. Vercel sends it with cron calls. Set this in the Vercel project env.
CRON_SECRET=
# Added automatically when you attach a Blob store to the project. Local runs use ./data instead.
BLOB_READ_WRITE_TOKEN=

# ---- Campaign autopilot ----
# Close campaign trades automatically on take-profit, stop-loss, 3-day limit and goal. Entries always need APPROVE.
AUTO_CLOSE=true
# Minutes between watchlist scans while a slot is free (each scan runs the analyst on a few names, ~20p each)
CAMPAIGN_SCAN_MIN_INTERVAL_MIN=120
# How many pre-screened names get full research and a cheap triage pass per scan
CAMPAIGN_TRIAGE_TOP=12
# How many triage survivors go to the full analyst per scan (~20p each)
CAMPAIGN_ANALYSE_TOP=5
# Minimum triage catalyst score (0-10) to reach the analyst
CAMPAIGN_MIN_CATALYST=4
# Minimum analyst confidence (0-1) to recommend
CAMPAIGN_MIN_CONFIDENCE=0.55
# Optional: free key from finnhub.io adds company news and earnings dates to every dossier
FINNHUB_API_KEY=

# ---- Optional research sources ----
# X/Twitter API v2 bearer token (paid tier). Leave blank to skip X.
X_BEARER_TOKEN=
# Tavily web search key. Leave blank to skip.
TAVILY_API_KEY=

# ---- Risk caps (enforced in code before any order is sent) ----
# Max single order as a fraction of free cash
RISK_MAX_ORDER_FRACTION=0.05
# Max order value in account currency
RISK_MAX_ORDER_VALUE=250
# Max orders the desk will submit per calendar day
RISK_MAX_ORDERS_PER_DAY=3
# Comma-separated T212 tickers the desk must never trade
RISK_BLOCKLIST=
