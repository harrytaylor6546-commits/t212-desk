# ---- Trading 212 ----
# practice = demo.trading212.com (fake money). live = real money. Default is practice.
T212_ENV=practice

# Generate in the T212 app: Settings > API (Beta). Switch to Practice FIRST for a demo key.
# Newer keys come as a key + secret pair (Basic auth). Older keys are a single token.
T212_API_KEY=
T212_API_SECRET=

# ---- Anthropic (analyst agent) ----
ANTHROPIC_API_KEY=

# ---- Optional research sources ----
# X/Twitter API v2 bearer token (paid tier). Leave blank to skip X.
X_BEARER_TOKEN=
# Tavily web search key. Leave blank to skip.
TAVILY_API_KEY=

# ---- Risk caps (enforced in code before any order is sent) ----
# Max single order as a fraction of free cash
RISK_MAX_ORDER_FRACTION=0.05
# Max order value in account currency
RISK_MAX_ORDER_VALUE=250
# Max orders the desk will submit per calendar day
RISK_MAX_ORDERS_PER_DAY=3
# Comma-separated T212 tickers the desk must never trade
RISK_BLOCKLIST=
